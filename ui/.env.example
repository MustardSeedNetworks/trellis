# Only needed when Vite's dev server (5173) and trellisd are separate origins.
# Leave it unset for the embedded UI: trellisd serves the bundle and the API
# from one listener, so the UI calls whatever origin it was loaded from and
# follows the daemon wherever TRELLIS_ADDR puts it.
VITE_TRELLIS_API=http://127.0.0.1:8080
