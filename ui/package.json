{
  "name": "trellis-ui",
  "version": "0.1.25",
  "private": true,
  "type": "module",
  "description": "Trellis Wi-Fi survey UI - Mustard Seed Networks",
  "engines": {
    "node": "26.7.0",
    "npm": "12.0.2"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "vite",
    "gen": "cd .. && buf generate --template buf.gen.ui.yaml",
    "typecheck": "tsc --build --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run --reporter=verbose --passWithNoTests",
    "test:watch": "vitest --reporter=dot"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-web": "2.1.2",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@tanstack/react-query": "5.101.4",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@biomejs/biome": "2.5.10",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
