{
  "name": "trellis-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trellis Wi-Fi survey UI - Mustard Seed Networks",
  "engines": {
    "node": "26.4.0",
    "npm": "11.18.0"
  },
  "packageManager": "npm@11.18.0",
  "scripts": {
    "dev": "vite",
    "gen": "cd .. && buf generate --template buf.gen.ui.yaml",
    "typecheck": "tsgo --build --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run --reporter=verbose --passWithNoTests",
    "test:watch": "vitest --reporter=dot"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-web": "2.1.2",
    "@tanstack/react-query": "5.101.4",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@tailwindcss/postcss": "4.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/node": "26.1.0",
    "@typescript/native-preview": "7.0.0-dev.20260706.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "29.1.1",
    "postcss": "8.5.15",
    "tailwindcss": "4.3.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
