{
  "name": "trellis-ui",
  "version": "0.2.94",
  "private": true,
  "type": "module",
  "description": "Trellis Wi-Fi survey UI - Mustard Seed Networks",
  "engines": {
    "node": "26.9.0",
    "npm": "12.0.2"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "vite",
    "gen": "cd .. && buf generate --template buf.gen.ui.yaml",
    "typecheck": "tsc --build --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "test:watch": "vitest --reporter=dot",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "npm run build-storybook -- --quiet && npm run test:storybook:run",
    "test:storybook:run": "vitest run --config vitest.storybook.config.ts --project=storybook",
    "test:storybook:contract": "../scripts/test-storybook-contract.sh"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@tanstack/react-query": "5.103.1",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.14",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.5",
    "@biomejs/biome": "2.5.14",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.13.0",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.1.0",
    "playwright": "1.63.0",
    "postcss": "8.5.28",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "ts-prune": "0.10.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
