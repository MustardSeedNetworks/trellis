# build / deps (for when code lands)
/engine/build/
/core/bin/
/ui/node_modules/
/ui/dist/
/ui/*.tsbuildinfo
/ui/.env

# Frontend build output (Vite builds directly to internal/api/ui/, embedded
# via go:embed — see internal/api/embed_ui.go and the Universal Build
# Contract in CLAUDE.md).
internal/api/ui/*
!internal/api/ui/.gitkeep
*.o
*.a
*.so
*.dylib
.DS_Store

# Migrations are source, not scratch output. A developer global gitignore may
# exclude *.sql (this one does), which drops them from commits silently — the
# build then fails at the //go:embed directive with "no matching files found",
# nowhere near the cause. The repo must be self-contained whatever any
# developer config says. seed carries the same un-ignore for the same reason.
!core/survey/migrations/*.sql
