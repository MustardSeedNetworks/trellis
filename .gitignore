# build / deps (for when code lands)
/engine/build/
/core/bin/
# `go build ./...` writes each main package into the working directory, so the
# daemon lands here by its package name. A 21 MB binary was tracked from #304
# until 2026-09-07 because of it.
/trellisd
/linklive-oracle
/ui/node_modules/
/ui/dist/
/ui/*.tsbuildinfo
/ui/.env

# Frontend build output (Vite builds directly to internal/api/ui/, embedded
# via go:embed — see internal/api/embed_ui.go and the Universal Build
# Contract in CLAUDE.md).
internal/api/ui/*
!internal/api/ui/.gitkeep
*.o
*.a
*.so
*.dylib
.DS_Store

# Go coverage profile produced by `go test -coverprofile` and by the backend CI
# job. Listed here rather than relied on from a developer's global gitignore, so
# the working tree is clean for everyone after a coverage run.
coverage.out

# Migrations are source, not scratch output. A developer global gitignore may
# exclude *.sql (this one does), which drops them from commits silently — the
# build then fails at the //go:embed directive with "no matching files found",
# nowhere near the cause. The repo must be self-contained whatever any
# developer config says. seed carries the same un-ignore for the same reason.
!core/survey/migrations/*.sql

# Playwright E2E output
ui/playwright-report/
ui/test-results/
bin/
# `go build ./...` writes each main package into the working directory, so the
# daemon lands here by its package name. A 21 MB binary was tracked from #304
# until 2026-09-07 because of it.
/trellisd
/linklive-oracle
ui/storybook-static/
